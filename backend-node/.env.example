# RESQ Node.js Backend Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/resq_flood

# Firebase Admin SDK Configuration
# Option 1: Path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option 2: JSON string or Base64 of serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT=

# Option 3: Individual credential fields
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
